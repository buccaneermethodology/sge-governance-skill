{
  "schema_version": "sge_reference_scope_v1",
  "markdown_patterns": [
    "README.md",
    "AGENTS.md",
    "kb/README.md",
    "kb/docs/**/*.md",
    "Dashboard/Rules.md",
    "Dashboard/Methodology.md",
    "Dashboard/Current_State.md",
    "Dashboard/Big_Ideas.md",
    "Dashboard/Stage_Plans.md",
    "Dashboard/Sessions.md",
    "Dashboard/Artifacts_Index.md",
    "Dashboard/Artifacts/Stage-Plan-SP-001/S001_*.md",
    "Dashboard/Artifacts/Stage-Plan-SP-001/SP001_*.md",
    "Dashboard/Artifacts/Stage-Plan-SP-002/SP002_*.md",
    "Dashboard/Artifacts/Stage-Plan-SP-001/Tombstones/*.md"
  ],
  "canonical_json_patterns": [
    "kb/data/strategy/*.json"
  ],
  "public_identity_patterns": [
    "README.md",
    ".gitignore",
    "AGENTS.md",
    ".codex/skills/sge-governed-checkpoints/**/*.md",
    ".codex/skills/sge-governed-checkpoints/**/*.py",
    ".codex/skills/sge-governed-checkpoints/**/*.json",
    "kb/README.md",
    "kb/render_manifest_v1.json",
    "kb/data/**/*.json",
    "kb/docs/**/*.md",
    "Dashboard/tools/**/*.py"
  ],
  "forbidden_public_tokens": [
    "/Users/xiaomei",
    "semx-cli",
    "semx-kb",
    ".semx/",
    "audio-transcriptor",
    "S-384",
    "S-485"
  ],
  "identity_exceptions": {
    "kb/data/strategy/sge_project_profile_v1.json": ["semx"],
    "kb/data/strategy/sge_workflow_registry_v1.json": ["build-kym", "build-tco-coverage"]
  },
  "tombstone_policy": "historical missing content is acceptable only when the source link points to an existing Tombstones artifact carrying locator_only_not_content_evidence"
}
