{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semx.dev/schemas/semx_doc_model_v1.json",
  "title": "Semx Doc Model V1",
  "type": "object",
  "required": [
    "doc_id",
    "doc_type",
    "title",
    "version",
    "status",
    "sections",
    "metadata"
  ],
  "properties": {
    "doc_id": {
      "type": "string"
    },
    "doc_type": {
      "type": "string",
      "enum": [
        "architecture",
        "logical_pipeline",
        "phase_spec",
        "strategy",
        "cli_spec",
        "artifact_spec",
        "evolution_log",
        "glossary",
        "adr"
      ]
    },
    "title": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "deprecated"
      ]
    },
    "metadata": {
      "type": "object",
      "required": [
        "owner",
        "updated_at",
        "source_scope"
      ],
      "properties": {
        "owner": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        },
        "source_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "depends_on_docs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "replaces_docs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "section_id",
          "heading",
          "kind",
          "content"
        ],
        "properties": {
          "section_id": {
            "type": "string"
          },
          "heading": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "narrative",
              "definition",
              "table",
              "checklist",
              "phase_contract",
              "dsl_spec",
              "json_schema_ref",
              "appendix"
            ]
          },
          "content": {
            "type": "object"
          },
          "constraints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "generated_markdown_hint": {
            "type": "string"
          }
        }
      }
    }
  }
}