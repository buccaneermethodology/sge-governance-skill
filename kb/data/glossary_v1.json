      {"term": "KB / Dashboard Truth Split", "definition": "KB承载稳定规则，Dashboard承载执行记忆、状态和证据。", "scope": "SGE治理", "authority": "kb/data/ 与 Dashboard/", "boundary": {"not": ["把投影当真源"], "claim_ceiling": "支撑正确的truth placement", "forbidden_overreads": ["用Dashboard closeout替代KB规则"]}, "related_concepts": ["Canonical Truth", "Closeout"], "source_refs": [".codex/skills/sge-governed-checkpoints/SKILL.md"]},
