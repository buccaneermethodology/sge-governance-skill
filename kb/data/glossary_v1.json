      {"term": "Evidence", "definition": "可定位、可重算并与声明边界匹配的观察或验证材料。", "scope": "SGE验收", "authority": "对应artifact与验证报告", "boundary": {"not": ["状态标签本身"], "claim_ceiling": "只支撑所覆盖的事实", "forbidden_overreads": ["把schema通过当作业务成功"]}, "related_concepts": ["Claim Ceiling", "Validation Handoff"], "source_refs": [".codex/skills/sge-governed-checkpoints/SKILL.md"]},
      {"term": "Candidate", "definition": "已构建并可验收、但尚未获得发布批准的候选产物。", "scope": "公共候选", "authority": "执行记忆与manifest", "boundary": {"not": ["published", "production-ready"], "claim_ceiling": "有界候选证据", "forbidden_overreads": ["把candidate当成release authorization"]}, "related_concepts": ["Promotion", "Claim Ceiling"], "source_refs": [".codex/skills/sge-governed-checkpoints/SKILL.md"]},
      {"term": "Claim Ceiling", "definition": "证据允许表达的最高结论强度。", "scope": "所有治理声明", "authority": "Goal/Contract/Validation", "boundary": {"not": ["质量评分"], "claim_ceiling": "不得超过最强可验证证据", "forbidden_overreads": ["把局部通过扩展为普遍适用"]}, "related_concepts": ["Evidence", "Scope Delta"], "source_refs": [".codex/skills/sge-governed-checkpoints/SKILL.md"]},
      {"term": "Scope Delta", "definition": "对原始目标的删除、替换、降级、延期或权限改变的显式记录。", "scope": "Goal conformance", "authority": "Goal与Dashboard", "boundary": {"not": ["隐式缩窄"], "claim_ceiling": "只能声明已批准或被阻断的范围", "forbidden_overreads": ["把未批准删项写成完成"]}, "related_concepts": ["Claim Ceiling", "Promotion"], "source_refs": [".codex/skills/sge-governed-checkpoints/SKILL.md"]},
      {"term": "Promotion", "definition": "把经过审查的稳定候选事实提升到更高权威层的受治理动作。", "scope": "truth placement", "authority": "显式promotion decision", "boundary": {"not": ["自动复制Dashboard"], "claim_ceiling": "仅覆盖被批准的稳定子集", "forbidden_overreads": ["把候选manifest当作KB法律"]}, "related_concepts": ["Canonical Truth", "Candidate"], "source_refs": [".codex/skills/sge-governed-checkpoints/SKILL.md"]},
      {"term": "Session", "definition": "Goal DAG中有明确目标、输入、产物和退出条件的执行单元。", "scope": "SGE执行", "authority": "项目执行记忆", "boundary": {"not": ["Goal终止条件"], "claim_ceiling": "最多关闭本Session范围", "forbidden_overreads": ["Session Done等于Goal complete"]}, "related_concepts": ["Stage Plan", "Closeout"], "source_refs": [".codex/skills/sge-governed-checkpoints/SKILL.md"]},
      {"term": "Stage Plan", "definition": "把Goal拆为有依赖关系的Sessions与退出条件的计划。", "scope": "SGE规划", "authority": "项目执行记忆", "boundary": {"not": ["实现证据"], "claim_ceiling": "支撑可追踪执行结构", "forbidden_overreads": ["计划落库等于执行完成"]}, "related_concepts": ["Session", "Scope Delta"], "source_refs": [".codex/skills/sge-governed-checkpoints/SKILL.md"]},
      {"term": "Lane Task Card", "definition": "绑定角色、输入digest、写范围和claim ceiling的委派合同。", "scope": "多代理执行", "authority": "lane_task_card_v1", "boundary": {"not": ["独立验证结论"], "claim_ceiling": "仅授权card声明的工作", "forbidden_overreads": ["摘要替代原始证据"]}, "related_concepts": ["Validation Handoff"], "source_refs": [".codex/skills/sge-governed-checkpoints/scripts/lane_task_card.py"]},
      {"term": "Validation Handoff", "definition": "交给独立Validation的输入、原始目标、证据、差异和声明边界包。", "scope": "SGE验收", "authority": "Dashboard closeout", "boundary": {"not": ["Validation verdict"], "claim_ceiling": "只证明交接完整", "forbidden_overreads": ["把handoff当作pass"]}, "related_concepts": ["Evidence", "Claim Ceiling"], "source_refs": [".codex/skills/sge-governed-checkpoints/SKILL.md"]},
      {"term": "Semantic Reviewer", "definition": "审查边界、truth placement、演进风险与实现入口语义的独立角色。", "scope": "高语义风险Goal", "authority": "独立review artifact", "boundary": {"not": ["Builder自审"], "claim_ceiling": "双verdict：设计冻结有效性与实现入口就绪性", "forbidden_overreads": ["review通过等于发布批准"]}, "related_concepts": ["Design Freeze Validity", "Implementation Entry Readiness"], "source_refs": [".codex/skills/sge-governed-checkpoints/SKILL.md"]},
      {"term": "Closeout", "definition": "对实际落地范围、证据、未完成项和后续候选的耐久执行记忆。", "scope": "SGE执行", "authority": "Dashboard/Artifacts/*_Closeout.md", "boundary": {"not": ["自动发布批准"], "claim_ceiling": "受证据与Goal completion rule约束", "forbidden_overreads": ["Dashboard Done等于生产就绪"]}, "related_concepts": ["Session", "Validation Handoff"], "source_refs": [".codex/skills/sge-governed-checkpoints/SKILL.md"]},
      {"term": "Design Freeze Validity", "definition": "判断设计边界、authority、scope delta和claim ceiling是否有效的verdict。", "scope": "Semantic Review", "authority": "Semantic Reviewer", "boundary": {"not": ["实现正确性"], "claim_ceiling": "只支撑设计层结论", "forbidden_overreads": ["倒推Builder已完成"]}, "related_concepts": ["Semantic Reviewer"], "source_refs": [".codex/skills/sge-governed-checkpoints/SKILL.md"]},
      {"term": "Implementation Entry Readiness", "definition": "判断Builder能否从最小安全切片开始而不越过边界的verdict。", "scope": "Semantic Review", "authority": "Semantic Reviewer", "boundary": {"not": ["实现结果"], "claim_ceiling": "支撑进入实现的条件", "forbidden_overreads": ["把ready当作landed"]}, "related_concepts": ["Minimum Safe Slice"], "source_refs": [".codex/skills/sge-governed-checkpoints/SKILL.md"]},
      {"term": "Minimum Safe Slice", "definition": "能被独立验证且不扩大权限、范围或公共身份的最小实现切片。", "scope": "实现入口", "authority": "Design Handoff", "boundary": {"not": ["完整产品能力"], "claim_ceiling": "仅支撑切片范围", "forbidden_overreads": ["切片通过等于全Goal完成"]}, "related_concepts": ["Implementation Entry Readiness"], "source_refs": [".codex/skills/sge-governed-checkpoints/SKILL.md"]},
      {"term": "Future-agent Misuse Scenario", "definition": "描述未来Agent可能如何误读持久表面的反例，用于设计防复发边界。", "scope": "治理设计", "authority": "Design/Semantic Review", "boundary": {"not": ["运行时规则"], "claim_ceiling": "支撑风险识别", "forbidden_overreads": ["场景本身不是发生事实"]}, "related_concepts": ["Claim Ceiling"], "source_refs": [".codex/skills/sge-governed-checkpoints/SKILL.md"]},
      {"term": "SGC", "definition": "检查声明强度、证据层、不变量和禁止折叠的结构治理合同。", "scope": "SGE治理", "authority": "kb/data/strategy/strategy_sgc_structural_contract_v1.json", "boundary": {"not": ["质量分数"], "claim_ceiling": "结构性支持", "forbidden_overreads": ["替代独立Validation"]}, "related_concepts": ["Evidence", "Claim Ceiling"], "source_refs": ["kb/data/strategy/strategy_sgc_structural_contract_v1.json"]},
      {"term": "ERBE", "definition": "先冻结机器可读合同与案例，再以同身份RED/GREEN和独立Validation验收的规范优先方法。", "scope": "高语义风险验收", "authority": "Goal Contract/Cases", "boundary": {"not": ["BDD投影本身"], "claim_ceiling": "支撑声明行为的可重算验收", "forbidden_overreads": ["producer自报状态不是验证"]}, "related_concepts": ["Evidence", "Validation Handoff"], "source_refs": ["kb/data/strategy/strategy_erbe_specification_first_acceptance_v1.json"]}
