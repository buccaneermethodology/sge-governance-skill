{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sge.local/schemas/sge_project_profile_v1.schema.json",
  "title": "SGE Project Profile v1",
  "type": "object",
  "required": ["schema_version", "profile_id", "project_id", "skill_id", "roots", "authority", "identity", "acceptance", "extensions", "non_goals"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "sge_project_profile_v1"},
    "profile_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "skill_id": {"const": "sge-governed-checkpoints"},
    "roots": {"type": "object", "required": ["kb_root", "dashboard_root", "skill_root"], "additionalProperties": false, "properties": {"kb_root": {"const": "kb"}, "dashboard_root": {"const": "Dashboard"}, "skill_root": {"type": "string"}}},
    "authority": {"type": "object", "required": ["product_design", "canonical_truth", "execution_memory", "derived_dkg", "registry"], "additionalProperties": false, "properties": {"product_design": {"const": "not_applicable"}, "canonical_truth": {"type": "string"}, "execution_memory": {"type": "string"}, "derived_dkg": {"anyOf": [{"const": "not_configured"}, {"type": "string", "pattern": "^Dashboard/(DKG|derived)/"}]}, "registry": {"type": "string"}}},
    "identity": {"type": "object", "required": ["project_name", "cli_name", "forbidden_target_authority_tokens"], "additionalProperties": false, "properties": {"project_name": {"type": "string"}, "cli_name": {"type": "string"}, "forbidden_target_authority_tokens": {"type": "array", "items": {"type": "string"}}}},
    "acceptance": {"type": "object", "required": ["default_mode", "claim_ceiling", "required_gates"], "additionalProperties": false, "properties": {"default_mode": {"enum": ["read_only", "implementation", "validation"]}, "claim_ceiling": {"type": "string"}, "required_gates": {"type": "array", "items": {"type": "string"}}}},
    "extensions": {"type": "object", "required": ["allowed_disabled_extension_ids", "orchestrator"], "additionalProperties": false, "properties": {"allowed_disabled_extension_ids": {"type": "array", "items": {"type": "string"}}, "orchestrator": {"type": "string"}}},
    "non_goals": {"type": "array", "items": {"type": "string"}}
  }
}
