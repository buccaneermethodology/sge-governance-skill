{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audio-transcriptor.local/schemas/glossary_v2_1.schema.json",
  "title": "SGE Glossary V2.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["doc_id", "doc_type", "title", "version", "status", "output_path", "metadata", "sections"],
  "properties": {
    "doc_id": {"type": "string", "minLength": 1},
    "doc_type": {"const": "glossary"},
    "title": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "status": {"type": "string", "minLength": 1},
    "output_path": {"type": "string", "minLength": 1},
    "metadata": {"$ref": "#/$defs/metadata"},
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/section"}
    }
  },
  "$defs": {
    "string_list": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "updated_at", "source_scope"],
      "properties": {
        "owner": {"type": "string", "minLength": 1},
        "updated_at": {"type": "string", "minLength": 1},
        "source_scope": {"$ref": "#/$defs/string_list"},
        "depends_on_docs": {"$ref": "#/$defs/string_list"},
        "tags": {"$ref": "#/$defs/string_list"},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section_id", "heading", "kind", "content"],
      "properties": {
        "section_id": {"type": "string", "minLength": 1},
        "heading": {"type": "string", "minLength": 1},
        "kind": {"const": "definition"},
        "content": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entries"],
          "properties": {
            "entries": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/entry"}
            }
          }
        }
      }
    },
    "entry": {
      "oneOf": [
        {"$ref": "#/$defs/legacy_entry"},
        {"$ref": "#/$defs/structured_entry"}
      ]
    },
    "legacy_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["term", "definition"],
      "properties": {
        "term": {"type": "string", "minLength": 1},
        "definition": {"type": "string", "minLength": 1},
        "notes": {"type": "string"}
      }
    },
    "structured_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "term",
        "definition",
        "scope",
        "owner",
        "authority",
        "boundary",
        "related_concepts",
        "source_refs"
      ],
      "properties": {
        "term": {"type": "string", "minLength": 1},
        "definition": {"type": "string", "minLength": 1},
        "full_name": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "authority": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "relationship": {"type": "string", "minLength": 1},
        "contains": {"$ref": "#/$defs/string_list"},
        "governs": {"$ref": "#/$defs/string_list"},
        "owns": {"$ref": "#/$defs/string_list"},
        "does_not_own": {"$ref": "#/$defs/string_list"},
        "boundary": {"$ref": "#/$defs/boundary"},
        "related_concepts": {"$ref": "#/$defs/string_list"},
        "source_refs": {"$ref": "#/$defs/string_list"},
        "notes": {"type": "string"}
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["not", "claim_ceiling", "forbidden_overreads"],
      "properties": {
        "not": {"$ref": "#/$defs/string_list"},
        "claim_ceiling": {"type": "string", "minLength": 1},
        "forbidden_overreads": {"$ref": "#/$defs/string_list"}
      }
    }
  }
}
